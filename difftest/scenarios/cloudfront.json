   "responses": [
     {"headers": {"Content-Type": "text/xml", "ETag": "E2"},
      "body": "<?xml version=\"1.0\"?><DistributionConfig xmlns=\"http://cloudfront.amazonaws.com/doc/2020-05-31/\"><CallerReference>r</CallerReference><Origins><Quantity>0</Quantity></Origins><DefaultCacheBehavior><TargetOriginId>t</TargetOriginId><ViewerProtocolPolicy>allow-all</ViewerProtocolPolicy></DefaultCacheBehavior><Comment></Comment><Enabled>true</Enabled></DistributionConfig>"},
     {"headers": {"Content-Type": "text/xml", "ETag": "E3"},
      "body": "<?xml version=\"1.0\"?><Distribution xmlns=\"http://cloudfront.amazonaws.com/doc/2020-05-31/\"><Id>D1</Id></Distribution>"}]},
  {"name": "cloudfront update-distribution get error",
