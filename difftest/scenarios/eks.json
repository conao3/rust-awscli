[
  {"name": "eks update-kubeconfig new file",
   "argv": ["eks", "update-kubeconfig", "--name", "demo", "--endpoint-url", "{endpoint}"],
   "responses": [{"headers": {"Content-Type": "application/json"},
     "body": "{\"cluster\": {\"name\": \"demo\", \"arn\": \"arn:aws:eks:us-west-2:123456789012:cluster/demo\", \"endpoint\": \"https://ABC.gr7.us-west-2.eks.amazonaws.com\", \"status\": \"ACTIVE\", \"certificateAuthority\": {\"data\": \"\"}}}"}],
   "outputs": ["home/.kube/config"]},
  {"name": "eks update-kubeconfig dry-run alias proxy role",
   "argv": ["eks", "update-kubeconfig", "--name", "demo", "--dry-run", "--alias", "ctx", "--user-alias", "me", "--proxy-url", "http://proxy:3128", "--role-arn", "arn:aws:iam::1:role/r", "--endpoint-url", "{endpoint}"],
   "responses": [{"headers": {"Content-Type": "application/json"},
     "body": "{\"cluster\": {\"name\": \"demo\", \"arn\": \"arn:aws:eks:us-west-2:123456789012:cluster/demo\", \"endpoint\": \"https://e\", \"status\": \"UPDATING\", \"certificateAuthority\": {\"data\": \"Y2VydA==\"}}}"}]},
  {"name": "eks update-kubeconfig existing verbose",
   "argv": ["eks", "update-kubeconfig", "--name", "demo", "--kubeconfig", "kc/config", "--verbose", "--profile", "default", "--endpoint-url", "{endpoint}"],
   "files": {"kc/config": "apiVersion: v1\nclusters:\n- cluster:\n    server: https://old\n  name: other\n- cluster:\n    server: https://old2\n  name: arn:aws:eks:us-west-2:123456789012:cluster/demo\ncontexts: []\ncurrent-context: other\nkind: Config\npreferences: {}\nusers:\n- name: someone\n  user:\n    token: 'abc: def'\n    extra: [1, 2.5, true, null]\n"},
   "responses": [{"headers": {"Content-Type": "application/json"},
     "body": "{\"cluster\": {\"name\": \"demo\", \"arn\": \"arn:aws:eks:us-west-2:123456789012:cluster/demo\", \"endpoint\": \"https://e\", \"status\": \"ACTIVE\", \"id\": \"abc-id\", \"outpostConfig\": {\"controlPlaneInstanceType\": \"m5.large\"}}}"}],
   "outputs": ["kc/config"]},
  {"name": "eks update-kubeconfig cluster creating",
   "argv": ["eks", "update-kubeconfig", "--name", "demo", "--endpoint-url", "{endpoint}"],
   "responses": [{"headers": {"Content-Type": "application/json"},
     "body": "{\"cluster\": {\"name\": \"demo\", \"arn\": \"arn:aws:eks:us-west-2:1:cluster/demo\", \"status\": \"CREATING\"}}"}]},
  {"name": "eks update-kubeconfig corrupted",
   "argv": ["eks", "update-kubeconfig", "--name", "demo", "--kubeconfig", "bad", "--endpoint-url", "{endpoint}"],
   "files": {"bad": "clusters: notalist\n"},
   "responses": [{"headers": {"Content-Type": "application/json"},
     "body": "{\"cluster\": {\"name\": \"demo\", \"arn\": \"arn:aws:eks:us-west-2:1:cluster/demo\", \"endpoint\": \"https://e\", \"status\": \"ACTIVE\"}}"}]},
  {"name": "eks update-kubeconfig missing name",
   "argv": ["eks", "update-kubeconfig"]},
  {"name": "eks get-token no cluster",
   "argv": ["eks", "get-token"]},
  {"name": "eks get-token both",
   "argv": ["eks", "get-token", "--cluster-name", "a", "--cluster-id", "b"]},
  {"name": "eks get-token text query",
   "argv": ["eks", "get-token", "--cluster-name", "a", "--query", "[kind,apiVersion,spec]", "--output", "text"]},
  {"name": "eks get-token yaml",
   "argv": ["eks", "get-token", "--cluster-id", "a", "--query", "kind", "--output", "yaml"]}
]
