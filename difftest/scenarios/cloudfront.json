   "masks": ["cli-[0-9]+-[0-9]+", "example.com-[0-9]+-[0-9]+"],
   "responses": [{"status": 201, "headers": {"Content-Type": "text/xml"},
     "body": "<?xml version=\"1.0\"?><Distribution xmlns=\"http://cloudfront.amazonaws.com/doc/2020-05-31/\"><Id>D1</Id></Distribution>"}]},
  {"name": "cloudfront create-distribution mutex",
   "argv": ["cloudfront", "create-distribution", "--origin-domain-name", "example.com", "--distribution-config", "{}", "--endpoint-url", "{endpoint}"]},
