    "body": "{\"services\": [{\"serviceArn\": \"arn:aws:ecs:us-east-1:1:service/c1/s1\", \"serviceName\": \"s1\", \"clusterArn\": \"arn:aws:ecs:us-east-1:1:cluster/c1\"}], \"failures\": []}"
   },
   {
    "status": 200,
    "headers": {
     "Content-Type": "application/x-amz-json-1.1"
    },
    "body": "{\"application\": {\"applicationName\": \"AppECS-c1-s1\", \"computePlatform\": \"ECS\"}}"
   },
   {
    "status": 200,
    "headers": {
     "Content-Type": "application/x-amz-json-1.1"
    },
    "body": "{\"deploymentGroupInfo\": {\"computePlatform\": \"ECS\", \"ecsServices\": [{\"serviceName\": \"s1\", \"clusterName\": \"c1\"}], \"blueGreenDeploymentConfiguration\": {\"deploymentReadyOption\": {\"waitTimeInMinutes\": 5}, \"terminateBlueInstancesOnDeploymentSuccess\": {\"terminationWaitTimeInMinutes\": 20}}}}"
   },
   {
    "status": 200,
    "headers": {
     "Content-Type": "application/x-amz-json-1.1"
    },
    "body": "{\"taskDefinition\": {\"taskDefinitionArn\": \"arn:aws:ecs:us-east-1:1:task-definition/f:2\"}}"
   },
   {
    "status": 200,
    "headers": {
     "Content-Type": "application/x-amz-json-1.1"
    },
    "body": "{\"deploymentId\": \"d-1\"}"
   },
   {
    "status": 200,
    "headers": {
     "Content-Type": "application/x-amz-json-1.1"
    },
    "body": "{\"deploymentInfo\": {\"status\": \"Succeeded\"}}"
   }
  ]
