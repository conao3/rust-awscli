   "td.json": "{\"family\": \"f\", \"containerDefinitions\": [{\"name\": \"web\", \"image\": \"nginx\"}]}",
   "appspec.yaml": "version: 0.0\nResources:\n  - TargetService:\n      Type: AWS::ECS::Service\n      Properties:\n        TaskDefinition: placeholder\n        LoadBalancerInfo:\n          ContainerName: web\n          ContainerPort: 80\n"
